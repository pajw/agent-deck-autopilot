#!/usr/bin/env python3
"""Give an unticketed agent-deck session a title that says what it is doing.

Ticketed sessions get their name from the ticket summary, in the rename hook.
Everything else — the spikes, investigations and one-offs — currently gets the
first few words of the first prompt, which is how a deck ends up with sessions
called "sodfk" and "thingy". Those are exactly the sessions whose purpose is
hardest to reconstruct a week later.

This reads the standing note written by agent-deck-session-note and asks a
cheap model for a short description of the work. It runs once per session: a
title that keeps changing is worse than a bad one, because you stop being able
to find anything.

Modes:
  (stdin JSON)      Claude Code Stop hook. Names the current session.
  --instance <id>   Name one session.
  --all             Name every eligible session.
  --enrich-tickets  Backfill ticket summaries onto titles still bare keys.
  --force           Ignore the once-per-session guard.
  --dry-run         Print what it would name things; change nothing.

Configuration (optional): ~/.config/agent-deck-autopilot.conf
  AGENTDECK_AUTONAME     0 disables entirely (default 1).
  AGENTDECK_NAME_MODEL   model to ask (default a small fast one).
  AGENTDECK_NAME_MIN_TURNS  turns before a session is worth naming (default 3).
  AGENTDECK_TICKET_TITLE_CMD / AGENTDECK_TITLE_MAX  used by --enrich-tickets.
"""

import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile

DEFAULT_MODEL = "claude-haiku-4-5-20251001"
MAX_TITLE = 40
CONF_KEYS = ("AGENTDECK_AUTONAME", "AGENTDECK_NAME_MODEL", "AGENTDECK_NAME_MIN_TURNS",
             "AGENTDECK_NOTES_DIR", "AGENTDECK_PROFILE", "AGENTDECK_TICKET_PREFIX",
             "AGENTDECK_TICKET_TITLE_CMD", "AGENTDECK_TITLE_MAX")

# Naming a session means launching a Claude process, which fires this hook
# again. Without a guard that recurses until something gives way.
if os.environ.get("AGENTDECK_AUTOPILOT_CHILD"):
    sys.exit(0)


def conf():
    path = os.path.expanduser("~/.config/agent-deck-autopilot.conf")
    got = dict.fromkeys(CONF_KEYS, "")
    if os.path.exists(path):
        script = '. "$1"; ' + "; ".join(f'printf "%s\\n" "${k}"' for k in CONF_KEYS)
        try:
            out = subprocess.run(["sh", "-c", script, "sh", path],
                                 capture_output=True, text=True, timeout=10).stdout
            got = dict(zip(CONF_KEYS, out.split("\n")))
        except Exception:
            pass
    return {k: (os.environ.get(k) or got.get(k) or "") for k in CONF_KEYS}


CONF = conf()


def notes_dir():
    return os.path.expanduser(
        CONF["AGENTDECK_NOTES_DIR"] or "~/.local/share/agent-deck-autopilot/sessions")


def agent_deck():
    return subprocess.run(
        ["sh", "-c", "command -v agent-deck || echo /opt/homebrew/bin/agent-deck"],
        capture_output=True, text=True).stdout.strip()


def rows(where="", args=()):
    profile = CONF["AGENTDECK_PROFILE"] or "default"
    db = os.path.expanduser(f"~/.agent-deck/profiles/{profile}/state.db")
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        con.row_factory = sqlite3.Row
        sql = f"select id, title, title_locked, status from instances {where}"
        return [dict(r) for r in con.execute(sql, args).fetchall()]
    except sqlite3.Error:
        return []


def has_ticket(text):
    prefix = CONF["AGENTDECK_TICKET_PREFIX"].strip()
    pat = (rf"\b{re.escape(prefix)}-?\d{{1,6}}\b" if prefix
           else r"\b[A-Z][A-Z0-9]{1,9}-\d{1,6}\b")
    return bool(re.search(pat, text or "", re.I if prefix else 0))


def note_of(instance_id):
    path = os.path.join(notes_dir(), f"{instance_id}.md")
    try:
        with open(path) as fh:
            return path, fh.read()
    except OSError:
        return path, ""


def front_value(text, field):
    m = re.search(rf"^{field}:\s*(.*)$", text.split("\n---", 1)[0], re.M)
    return m.group(1).strip() if m else ""


PROMPT = """Below is a record of a terminal coding session. Reply with a title \
for it: two to five lower-case words naming the specific work in progress. No \
punctuation, no quotes, no preamble, no trailing full stop. Name the subject \
matter, not the activity: "oauth router timeouts" not "debugging some code". \
If the record is too thin to tell, reply with the single word: unknown

--- session record ---
%s
--- end record ---"""


def child_env():
    """Environment for a `claude -p` child that must not be mistaken for you.

    Agent Deck identifies the current session from tmux, and its own hooks run
    in any Claude process. A child started inside a deck pane therefore gets
    adopted by that deck session: its transcript is recorded as the session's,
    and the next standing note is written from the namer's conversation rather
    than yours. Strip tmux from the environment and run somewhere else, so
    nothing links the child back to the session that asked the question.
    """
    env = {k: v for k, v in os.environ.items()
           if k not in ("TMUX", "TMUX_PANE") and not k.startswith("AGENTDECK_")}
    env["AGENTDECK_AUTOPILOT_CHILD"] = "1"
    return env


def ask(model, body):
    try:
        out = subprocess.run(
            ["claude", "-p", "--model", model, PROMPT % body],
            capture_output=True, text=True, timeout=120,
            cwd=tempfile.gettempdir(), env=child_env())
    except Exception:
        return ""
    if out.returncode != 0:
        return ""
    text = (out.stdout or "").strip().strip("\"'`")
    # A model that decided to explain itself has not answered the question.
    if not text or "\n" in text or len(text) > MAX_TITLE:
        return ""
    text = re.sub(r"[^\w\s-]", "", text).strip().lower()
    if not text or text == "unknown" or len(text.split()) > 6:
        return ""
    return text


def eligible(row, force):
    if has_ticket(row.get("title", "")):
        return None, "ticketed; the rename hook owns this one"
    # Deliberately not gated on title_locked. The lock exists to stop
    # agent-deck's own name sync (upstream #697) and gets applied in bulk, so
    # it says nothing about whether a human chose the title. The once-only
    # guard is the auto_named stamp below, which means a rename of your own
    # after the fact is final.
    path, note = note_of(row["id"])
    if not note:
        return None, "no note yet"
    if front_value(note, "auto_named") and not force:
        return None, "already auto-named"
    try:
        min_turns = int(CONF["AGENTDECK_NAME_MIN_TURNS"] or 3)
    except ValueError:
        min_turns = 3
    turns = re.sub(r"\D", "", front_value(note, "turns") or "0")
    if int(turns or 0) < min_turns:
        return None, f"only {turns or 0} turn(s)"
    return (path, note), ""


def body_of(note):
    """The parts of a note that say what the work is."""
    body = note.split("\n---", 1)[-1]
    return body[:4000]


def stamp(path, name):
    try:
        with open(path) as fh:
            text = fh.read()
        text = re.sub(r"^auto_named:.*\n", "", text, flags=re.M)
        text = text.replace("---\n", f"---\nauto_named: {name}\n", 1)
        with open(path, "w") as fh:
            fh.write(text)
    except OSError:
        pass


def process(row, model, force, dry):
    got, why = eligible(row, force)
    if not got:
        return f"skip {row['id'][:8]} ({row.get('title','')}): {why}"
    path, note = got
    name = ask(model, body_of(note))
    if not name:
        return f"skip {row['id'][:8]}: model gave nothing usable"
    if dry:
        return f"would rename {row['id'][:8]} '{row.get('title','')}' -> '{name}'"
    ad = agent_deck()
    subprocess.run([ad, "rename", row["id"], name], capture_output=True, timeout=20)
    subprocess.run([ad, "session", "set-title-lock", row["id"], "on"],
                   capture_output=True, timeout=20)
    stamp(path, name)
    return f"renamed {row['id'][:8]} '{row.get('title','')}' -> '{name}'"


def ticket_key(title):
    prefix = CONF["AGENTDECK_TICKET_PREFIX"].strip()
    pat = (rf"\b({re.escape(prefix)})-?(\d{{1,6}})\b" if prefix
           else r"\b([A-Z][A-Z0-9]{1,9})-(\d{1,6})\b")
    m = re.search(pat, title or "", re.I if prefix else 0)
    return f"{m.group(1).upper()}-{m.group(2)}" if m else ""


def enrich_tickets(dry):
    """Backfill ticket summaries onto titles that are still a bare key.

    The rename hook does this on the next prompt in a session, which means a
    deck configured today stays full of bare keys until each session is
    touched. This catches them up in one pass.
    """
    cmd = CONF["AGENTDECK_TICKET_TITLE_CMD"].strip()
    if not cmd:
        print("no AGENTDECK_TICKET_TITLE_CMD configured")
        return
    try:
        limit = int(CONF["AGENTDECK_TITLE_MAX"] or 30)
    except ValueError:
        limit = 30
    for row in rows("where archived_at = 0"):
        title, key = row.get("title", ""), ticket_key(row.get("title", ""))
        if not key or title != key:
            continue
        try:
            out = subprocess.run(["sh", "-c", f'{cmd} "$1"', "sh", key],
                                 capture_output=True, text=True, timeout=25)
        except Exception:
            continue
        text = re.sub(r"\s+", " ", (out.stdout or "").strip())
        if out.returncode != 0 or not text:
            print(f"skip {key}: no summary")
            continue
        kept = []
        for word in text.split():
            if len(" ".join(kept + [word])) > limit:
                break
            kept.append(word)
        desired = f"{key} {' '.join(kept).strip(' ,;:|-')}".strip()
        if desired == title:
            continue
        if dry:
            print(f"would rename {row['id'][:8]} '{title}' -> '{desired}'")
            continue
        subprocess.run([agent_deck(), "rename", row["id"], desired],
                       capture_output=True, timeout=20)
        print(f"renamed {row['id'][:8]} '{title}' -> '{desired}'")


def current_id():
    if not os.environ.get("TMUX"):
        return ""
    try:
        name = subprocess.run(["tmux", "display-message", "-p", "#S"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
        if not name.startswith("agentdeck_"):
            return ""
        cur = json.loads(subprocess.run([agent_deck(), "session", "current", "--json"],
                                        capture_output=True, text=True,
                                        timeout=15).stdout or "{}")
        return cur.get("id", "")
    except Exception:
        return ""


def main():
    args = sys.argv[1:]
    if (CONF["AGENTDECK_AUTONAME"] or "1") == "0":
        return 0
    model = CONF["AGENTDECK_NAME_MODEL"] or DEFAULT_MODEL
    force, dry = "--force" in args, "--dry-run" in args
    if "--enrich-tickets" in args:
        enrich_tickets(dry)
        return 0
    verbose = bool(set(args) & {"--all", "--instance", "--dry-run"})

    if "--all" in args:
        targets = rows("where archived_at = 0 and tool = 'claude'")
    elif "--instance" in args:
        targets = rows("where id like ?", (args[args.index("--instance") + 1] + "%",))
    else:
        sys.stdin.read()  # drain the hook payload; the registry is the source
        sid = current_id()
        targets = rows("where id = ?", (sid,)) if sid else []

    for row in targets:
        line = process(row, model, force, dry)
        if verbose:
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
