<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-deck-autopilot.housekeeping</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/agent-deck-housekeeping</string>
  </array>
  <!-- Fridays at 15:00; adjust to taste -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>15</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/agent-deck-housekeeping.err.log</string>
</dict>
</plist>
